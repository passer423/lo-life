# ---------- 服务绑定 ----------
# 本机开发用 127.0.0.1；手机/局域网访问改成 0.0.0.0（见 README 的 Tailscale 一节）
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ---------- 数据目录 ----------
# 默认是本项目下的 data/。想把衣柜照片放到网盘同步目录或另一块盘就改这里：
# DATA_DIR=D:\lo-data
# 注意：改完之后要重新跑一次 build_kb_index.py（索引也在这个目录下）。
# 知识库/尺码表/洗护规则在 content/ 下（进 git），要挪位置用 CONTENT_DIR。

# ---------- 上游知识管线 ----------
# 复用 lolita-rag 的 清洗/切分/BGE/混合检索/闸门/verify，不复制代码
LOLITA_RAG_ROOT=D:\Users\50436\Documents\Trae-CN\temp_20261012_01\lolita-rag

# ---------- LLM（可选）----------
# 留空时「知识问答」自动退化为「原文摘录 + 引用编号」，先验证检索链路；
# 但「助手」(/api/chat) **必须有模型**：留空时该接口返回 503 并说明怎么配。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 检索 ----------
# 只展示最相关的一条。想多看几条就调大——但注意答案里的 [n] 引用只与返回的条目
# 一一对应，调大之后界面会同时出现更多来源卡片。
TOP_K=1
