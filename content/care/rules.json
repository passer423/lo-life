      "advice": [
        "翻面并装进洗衣袋，避免绣线与拉链、扣子互相摩擦起毛。"
      ],
      "ref": ""
    },
    {
      "id": "leisi",
      "title": "蕾丝、网纱、欧根纱怕勾丝与变形",
      "severity": "warn",
      "blocks_machine_wash": false,
      "tags": { "materials": ["蕾丝", "网纱", "欧根纱"] },
      "advice": [
